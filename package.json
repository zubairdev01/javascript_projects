{
  "name": "psx-insight-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix ./PSX_TradingMentorCRM/client run dev\" \"npm --prefix ./PSX_TradingMentorCRM/server run dev\"",
    "install:server": "npm --prefix ./PSX_TradingMentorCRM/server install",
    "install:client": "npm --prefix ./PSX_TradingMentorCRM/client install",
    "prisma:generate": "npm --prefix ./PSX_TradingMentorCRM/server run generate",
    "build": "npm run install:server && npm run prisma:generate && npm run install:client && npm --prefix ./PSX_TradingMentorCRM/client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "vite": "^8.3.4"
  }
}